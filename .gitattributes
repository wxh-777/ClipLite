* text=auto

# Keep source and documentation line endings stable in reviews.
*.c text eol=lf
*.cc text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf
*.md text eol=lf
*.ps1 text eol=lf

# Windows command files retain their native line endings.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary and generated artifacts are never normalized.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.bin binary
*.zip binary
*.exe binary
